# ─────────────────────────────────────────────────────────────────────────────
# DISCOVER EGYPT — environment variables. Copy to .env.local and fill in.
# PLACEHOLDERS ONLY. Never commit real values. .env.local is git-ignored.
# ─────────────────────────────────────────────────────────────────────────────

# Public URL of the site (used for metadata and sign-in redirects)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Supabase (production mode) ───────────────────────────────────────────────
# Project Settings → API. The anon key is safe in the browser: Row Level Security protects the data.
NEXT_PUBLIC_SUPABASE_URL=
# Project Settings → API Keys → Publishable key (sb_publishable_…). The legacy "anon" key also works
# here, as NEXT_PUBLIC_SUPABASE_ANON_KEY, but Supabase is retiring it.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# SERVER ONLY. Bypasses RLS. Never prefix with NEXT_PUBLIC_, never expose to the browser.
# Project Settings → API Keys → Secret key (sb_secret_…). Legacy alternative: SUPABASE_SERVICE_ROLE_KEY.
SUPABASE_SECRET_KEY=

# ── Local demo mode (development only) ───────────────────────────────────────
# Lets the whole app run with no Supabase project: submissions go to .data/local-db.json
# and there is one admin password. Ignored when Supabase is configured; refused on Vercel production.
DEMO_LOCAL_MODE=true
# At least 12 characters
LOCAL_ADMIN_PASSWORD=change-me-to-a-long-password
# At least 32 random characters, e.g. `openssl rand -base64 48`
SESSION_SECRET=replace-with-at-least-32-random-characters

# ── Scheduled jobs (production) ──────────────────────────────────────────────
# Vercel Cron sends it as "Authorization: Bearer <value>" to /api/cron/print-sweep (see vercel.json),
# which deletes postcard images of print requests that expired uncollected. At least 16 random characters.
CRON_SECRET=
